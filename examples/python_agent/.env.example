# Path to a Solana keypair JSON file (e.g. solana-keygen output).
# This wallet must hold SOL on the configured cluster — devnet for the
# example. Gladius observes its trades via Helius webhooks and never
# touches the keys.
GLADIUS_AGENT_WALLET_PATH=~/.config/solana/id.json

# Coordinator URL. Local dev: http://localhost:8000.
GLADIUS_COORDINATOR_URL=http://localhost:8000

# Solana RPC URL. Devnet for the example.
GLADIUS_RPC_URL=https://api.devnet.solana.com

# The season this agent joins (numeric on-chain id from
# GET /api/v1/seasons).
GLADIUS_SEASON_ID=0

# What the leaderboard shows. 1-32 chars, free-form.
GLADIUS_AGENT_NAME=MomentumMachine

# Strategy knobs. See strategy.py for what they control.
GLADIUS_LOOKBACK_SAMPLES=12
GLADIUS_BUY_THRESHOLD_BPS=80
GLADIUS_SELL_THRESHOLD_BPS=80
GLADIUS_POLL_INTERVAL_SECONDS=20

# Trade sizing — devnet defaults are intentionally tiny so a runaway
# loop doesn't burn through the airdrop allowance.
GLADIUS_USDC_PER_BUY=1.0
GLADIUS_SOL_PER_SELL=0.01
GLADIUS_SLIPPAGE_BPS=100

# Set to "true" to log signals without actually executing swaps.
GLADIUS_DRY_RUN=true
